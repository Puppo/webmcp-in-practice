# Copy to .env (never commit it). webmcp-evals loads it automatically.
# Set only the key for the provider you select with --model.

# Google Gemini (default, e.g. gemini-3.5-flash or google:gemini-3.5-flash).
# GEMINI_API_KEY and GOOGLE_GENERATIVE_AI_API_KEY are also accepted.
GOOGLE_AI=your_gemini_api_key

# OpenAI (--model openai:<model>)
OPENAI_API_KEY=your_openai_api_key

# Anthropic (--model anthropic:<model>)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Ollama (--model ollama:<model>), no key required
# OLLAMA_HOST=http://127.0.0.1:11434

# Optional endpoint overrides for gateways or OpenAI-compatible services
# OPENAI_BASE_URL=https://your-proxy.example.com/v1
# ANTHROPIC_BASE_URL=https://your-proxy.example.com/anthropic
# GOOGLE_GENERATIVE_AI_BASE_URL=https://your-proxy.example.com/google
